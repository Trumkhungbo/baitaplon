<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="768.0" prefWidth="1024.0" styleClass="root-container" stylesheets="@global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.SellingJobs.ItemShowingHandle">
    <children>
        <ScrollPane fitToWidth="true" fitToHeight="false" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox alignment="TOP_CENTER" spacing="30.0">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
                    </padding>
                    <children>

                        <!-- HEADER: Nút Quay Lại -->
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Button mnemonicParsing="false" onAction="#ReturnToInvesment" style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-cursor: hand; -fx-font-size: 14px;" text="← Quay lại phòng chờ" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-text-fill: #FACC15; -fx-font-size: 20px; -fx-font-weight: bold;" text="Chi Tiết Đấu Giá" />
                            </children>
                        </HBox>

                        <!-- THÂN TRANG: Cột Ảnh và Cột Thông Tin -->
                        <HBox alignment="TOP_CENTER" spacing="40.0">
                            <children>

                                <!-- Cột Trái: Hình Ảnh Sản Phẩm (Đã fix để không bị giãn) -->
                                <VBox alignment="TOP_CENTER" styleClass="card" HBox.hgrow="NEVER" maxHeight="-Infinity">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                    <children>
                                        <ImageView fx:id="image" fitHeight="350.0" fitWidth="350.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../assets/rubberDuck.jfif" />
                                            </image>
                                        </ImageView>
                                    </children>
                                </VBox>

                                <!-- Cột Phải: Thông tin & Đặt giá -->
                                <VBox spacing="25.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <!-- Khối Thông Tin Chi Tiết (Ôm sát nội dung) -->
                                        <VBox spacing="10.0" styleClass="card" maxHeight="-Infinity">
                                            <padding>
                                                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                                            </padding>
                                            <children>
                                                <Label fx:id="name" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;" text="Tên Sản Phẩm" wrapText="true" />

                                                <HBox spacing="15.0">
                                                    <children>
                                                        <Label style="-fx-text-fill: #A0A0A0;" text="Trạng thái:" />
                                                        <Label fx:id="status" style="-fx-text-fill: #4CAF50; -fx-font-weight: bold;" text="Đang diễn ra" />
                                                    </children>
                                                </HBox>

                                                <Separator style="-fx-background-color: #333333; -fx-opacity: 0.2;">
                                                    <VBox.margin>
                                                        <Insets bottom="10.0" top="10.0" />
                                                    </VBox.margin>
                                                </Separator>

                                                <Label style="-fx-text-fill: #666666;" text="Mô tả sản phẩm:" />
                                                <!-- Đã bỏ VBox.vgrow="ALWAYS" để chữ không đẩy giá tiền xuống đáy -->
                                                <Label fx:id="description" style="-fx-text-fill: #CCCCCC; -fx-font-size: 14px;" text="Mô tả chi tiết sản phẩm..." wrapText="true" />

                                                <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 16px;" text="Giá hiện tại:" />
                                                        <Label fx:id="price" style="-fx-text-fill: #FACC15; -fx-font-size: 28px; -fx-font-weight: bold;" text="0 VNĐ" />
                                                    </children>
                                                    <VBox.margin>
                                                        <Insets top="15.0" />
                                                    </VBox.margin>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- Khối Nhập Giá Đấu -->
                                        <VBox spacing="15.0" styleClass="card" style="-fx-border-color: #FACC15; -fx-border-radius: 15px; -fx-border-width: 1px;" maxHeight="-Infinity">
                                            <padding>
                                                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                                            </padding>
                                            <children>
                                                <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" text="Ra giá đấu" />
                                                <HBox spacing="15.0">
                                                    <children>
                                                        <TextField fx:id="money" promptText="Nhập số tiền..." styleClass="input-field" HBox.hgrow="ALWAYS" />
                                                        <Button mnemonicParsing="false" onAction="#RaiseBind" prefWidth="150.0" styleClass="btn-gold" text="Xác nhận cược" />
                                                    </children>
                                                </HBox>
                                                <Label style="-fx-text-fill: #666666; -fx-font-size: 12px;" text="* Mức giá phải cao hơn giá hiện tại tối thiểu 5%." />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- BẢNG PHÍA DƯỚI: Lịch Sử Đấu Giá -->
                        <!-- Đã fix chiều cao bảng (prefHeight/minHeight) để không giãn tới vô tận -->
                        <VBox spacing="15.0" styleClass="card" maxHeight="-Infinity">
                            <padding>
                                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                            </padding>
                            <children>
                                <Label style="-fx-text-fill: #FACC15; -fx-font-size: 18px; -fx-font-weight: bold;" text="Lịch sử đấu giá" />
                                <TableView prefHeight="300.0" minHeight="300.0" styleClass="custom-table">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn text="Người đấu (Name)" />
                                        <TableColumn text="Mức giá (Price)" />
                                        <TableColumn text="Thời gian (TimeLog)" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</StackPane>