<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="768.0" prefWidth="1024.0" styleClass="root-container" stylesheets="@global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.SellingJobs.ItemShowingHandle">
    <children>
        <ScrollPane fitToHeight="false" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox alignment="TOP_CENTER" spacing="30.0">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="30.0" />
                    </padding>
                    <children>

                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Button mnemonicParsing="false" onAction="#ReturnToInvesment" style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-cursor: hand; -fx-font-size: 14px;" text="← Quay lại phòng chờ" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-text-fill: #FACC15; -fx-font-size: 20px; -fx-font-weight: bold;" text="Chi Tiết Đấu Giá" />
                            </children>
                        </HBox>

                        <HBox alignment="TOP_CENTER" spacing="40.0">
                            <children>
                                <VBox alignment="TOP_CENTER" maxHeight="-Infinity" styleClass="card" HBox.hgrow="NEVER">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                    <children>
                                        <ImageView fx:id="image" fitHeight="380.0" fitWidth="380.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../assets/rubberDuck.jfif" />
                                            </image>
                                        </ImageView>
                                    </children>
                                </VBox>

                                <VBox spacing="25.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <VBox maxHeight="-Infinity" spacing="15.0" styleClass="card">
                                            <padding>
                                                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                                            </padding>
                                            <children>
                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label fx:id="name" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;" text="Tên Sản Phẩm" wrapText="true" />
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <Label fx:id="status" style="-fx-text-fill: #4CAF50; -fx-font-weight: bold; -fx-font-size: 12px; -fx-border-color: #4CAF50; -fx-border-radius: 4px; -fx-padding: 2 8;" text="LIVE" />
                                                                <Label style="-fx-text-fill: #666666;" text="•" />
                                                                <Label fx:id="Type" style="-fx-text-fill: #A0A0A0; -fx-font-size: 13px;" text="Phân loại: Điện tử" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>

                                                <Separator style="-fx-opacity: 0.1;" />

                                                <FlowPane hgap="15.0" vgap="10.0">
                                                    <children>
                                                        <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #262626; -fx-background-radius: 8; -fx-padding: 8 12;">
                                                            <children>
                                                                <Label style="-fx-text-fill: #666666;" text="Thông tin 1:" />
                                                                <Label fx:id="information1" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Việt Nam" />
                                                            </children>
                                                        </HBox>
                                                        <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #262626; -fx-background-radius: 8; -fx-padding: 8 12;">
                                                            <children>
                                                                <Label style="-fx-text-fill: #666666;" text="Thông tin 2:" />
                                                                <Label fx:id="information2" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Mới 99%" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </FlowPane>

                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label style="-fx-text-fill: #666666; -fx-font-size: 12px;" text="Mô tả chi tiết:" />
                                                        <Label fx:id="description" lineSpacing="5.0" style="-fx-text-fill: #CCCCCC; -fx-font-size: 14px;" text="Mô tả sản phẩm chi tiết sẽ được hiển thị tại đây để người dùng dễ dàng theo dõi thông tin..." wrapText="true" />
                                                    </children>
                                                </VBox>

                                                <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                                                    <children>
                                                        <VBox>
                                                            <children>
                                                                <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 14px;" text="Mức giá cao nhất hiện tại" />
                                                                <Label fx:id="price" style="-fx-text-fill: #FACC15; -fx-font-size: 36px; -fx-font-weight: bold;" text="15.000.000 VNĐ" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <VBox maxHeight="-Infinity" spacing="15.0" style="-fx-border-color: #FACC15; -fx-border-radius: 15px; -fx-border-width: 1px;" styleClass="card">
                                            <padding>
                                                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                                            </padding>
                                            <children>
                                                <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" text="Phiên đấu giá đang diễn ra" />
                                                <HBox spacing="15.0">
                                                    <children>
                                                        <TextField fx:id="money" prefHeight="45.0" promptText="Nhập số tiền muốn đấu..." styleClass="input-field" HBox.hgrow="ALWAYS" />
                                                        <Button mnemonicParsing="false" onAction="#RaiseBind" prefHeight="45.0" prefWidth="180.0" styleClass="btn-gold" text="ĐẶT GIÁ NGAY" />
                                                    </children>
                                                </HBox>
                                                <HBox spacing="5.0">
                                                    <children>
                                                        <Label style="-fx-text-fill: #666666; -fx-font-size: 12px;" text="* Giá thầu tiếp theo tối thiểu:" />
                                                        <Label style="-fx-text-fill: #FACC15; -fx-font-size: 12px; -fx-font-weight: bold;" text="15.750.000 VNĐ" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox maxHeight="-Infinity" spacing="15.0" styleClass="card">
                            <padding>
                                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                            </padding>
                            <children>
                                <Label style="-fx-text-fill: #FACC15; -fx-font-size: 18px; -fx-font-weight: bold;" text="Lịch sử đấu giá gần đây" />
                                <TableView minHeight="300.0" prefHeight="300.0" styleClass="custom-table">
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <columns>
                                        <TableColumn text="Người đấu" />
                                        <TableColumn text="Giá tiền" />
                                        <TableColumn text="Thời điểm" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</StackPane>
