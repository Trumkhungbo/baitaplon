<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="760.0" prefWidth="1100.0" styleClass="root-container" stylesheets="@global.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.controller.SellingJobs.InvesterSellHandle">
   <children>
      <VBox alignment="TOP_CENTER" maxHeight="720.0" maxWidth="1060.0" spacing="18.0" styleClass="card">
         <padding>
            <Insets bottom="28.0" left="32.0" right="32.0" top="24.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label fx:id="pageTitle" style="-fx-text-fill: #FACC15; -fx-font-size: 24px; -fx-font-weight: bold;" text="Đăng bán sản phẩm mới" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 13px;" text="Hệ thống đấu giá MiniBoom" />
               </children>
            </HBox>

            <HBox spacing="40.0" VBox.vgrow="ALWAYS">
               <children>
                  <GridPane hgap="15.0" vgap="14.0" HBox.hgrow="ALWAYS">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="160.0" minWidth="10.0" prefWidth="140.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="390.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="42.0" />
                        <RowConstraints minHeight="76.0" prefHeight="86.0" />
                        <RowConstraints minHeight="10.0" prefHeight="42.0" />
                        <RowConstraints minHeight="10.0" prefHeight="42.0" />
                        <RowConstraints minHeight="10.0" prefHeight="42.0" />
                        <RowConstraints minHeight="10.0" prefHeight="42.0" />
                        <RowConstraints minHeight="10.0" prefHeight="42.0" />
                        <RowConstraints minHeight="10.0" prefHeight="42.0" />
                        <RowConstraints minHeight="10.0" prefHeight="42.0" />
                     </rowConstraints>
                     <children>
                        <Label style="-fx-text-fill: #666666;" text="Tên sản phẩm:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="itemname" promptText="VD: iPhone 13 Pro Max" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label style="-fx-text-fill: #666666;" text="Mô tả sản phẩm:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextArea fx:id="productDescription" prefRowCount="3" promptText="Nhập mô tả chi tiết sản phẩm..." styleClass="input-field" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label style="-fx-text-fill: #666666;" text="Phân loại:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <ChoiceBox fx:id="description" prefWidth="250.0" styleClass="custom-choice-box" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label style="-fx-text-fill: #666666;" text="Thông tin 1:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <TextField fx:id="description1" promptText="ART: artist / ELECTRONICS: brand / VEHICLE: engineType" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label style="-fx-text-fill: #666666;" text="Thông tin 2:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <TextField fx:id="description2" promptText="ART: creationYear / ELECTRONICS: warrantyMonths / VEHICLE: mileage" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label style="-fx-text-fill: #666666;" text="Giá khởi điểm (VNĐ):" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                        <TextField fx:id="price" promptText="VD: 5.000.000" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                        <Label style="-fx-text-fill: #666666;" text="Ngày bắt đầu:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                        <DatePicker fx:id="auctionDate" prefWidth="390.0" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                        <Label style="-fx-text-fill: #666666;" text="Giờ bắt đầu:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                        <TextField fx:id="TimeStart" promptText="VD: 10:00:00" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                        <Label style="-fx-text-fill: #666666;" text="Thời lượng (Phút):" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                        <TextField fx:id="duration" promptText="VD: 60" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                     </children>
                  </GridPane>

                  <VBox alignment="TOP_CENTER" prefWidth="320.0" spacing="15.0">
                     <children>
                        <Label style="-fx-text-fill: #A0A0A0; -fx-font-weight: bold;" text="Hình ảnh sản phẩm" />
                        <StackPane styleClass="image-upload-placeholder" VBox.vgrow="ALWAYS">
                           <children>
                              <ImageView fx:id="imageset" fitHeight="250.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" />
                              <Button mnemonicParsing="false" onAction="#AddImage" styleClass="btn-add-image" text="+" StackPane.alignment="BOTTOM_RIGHT">
                                 <StackPane.margin>
                                    <Insets bottom="10.0" right="10.0" />
                                 </StackPane.margin>
                              </Button>
                           </children>
                        </StackPane>
                        <Label style="-fx-text-fill: #666666; -fx-font-size: 11px;" text="Hỗ trợ: JPG, PNG. Tối đa 5MB." />
                        <Label fx:id="statusLabel" style="-fx-text-fill: #FACC15; -fx-font-size: 12px;" text="" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button fx:id="submitButton" mnemonicParsing="false" onAction="#Clicked" prefWidth="180.0" styleClass="btn-gold" text="Đăng bán ngay" />
               </children>
            </HBox>
            <Pane prefHeight="0.0" prefWidth="820.0">
               <children>
                  <Label style="-fx-text-fill: #FACC15; -fx-font-size: 12px; -fx-font-weight: bold;" text="Thông tin 1: ART = artist, ELECTRONICS = brand, VEHICLE = engineType" />
               </children>
            </Pane>
            <Pane prefHeight="0.0" prefWidth="820.0">
               <children>
                  <Label style="-fx-text-fill: #FACC15; -fx-font-size: 12px; -fx-font-weight: bold;" text="Thông tin 2: ART = creationYear, ELECTRONICS = warrantyMonths, VEHICLE = mileage" />
               </children>
            </Pane>
         </children>
      </VBox>
   </children>
</StackPane>
