<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="ShowingStage" prefHeight="768.0" prefWidth="1024.0" stylesheets="@global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.MainUI.AdminLobbyHandle">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: #1A1A1A; -fx-border-color: #333333; -fx-border-width: 0 0 1px 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../assets/Icon.png" />
                            </image>
                        </ImageView>
                        <VBox alignment="CENTER_LEFT">
                            <children>
                                <Label style="-fx-text-fill: #FACC15; -fx-font-size: 20px; -fx-font-weight: bold; -fx-letter-spacing: 1;" text="MiniBoom" />
                                <Label style="-fx-text-fill: #666666; -fx-font-size: 10px; -fx-font-weight: bold;" text="ADMIN SYSTEM" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Region prefHeight="79.0" prefWidth="97.0" />

                <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                    <fx:define>
                        <ToggleGroup fx:id="adminNavGroup" />
                    </fx:define>
                    <children>
                        <ToggleButton mnemonicParsing="false" onAction="#MovingToAccountPage" prefHeight="40.0" prefWidth="140.0" selected="true" styleClass="switch-btn" text="Tài Khoản" toggleGroup="$adminNavGroup" HBox.hgrow="ALWAYS" />
                        <ToggleButton mnemonicParsing="false" onAction="#MovingToHandleUserRequest" prefHeight="40.0" prefWidth="140.0" styleClass="switch-btn" text="Yêu Cầu" toggleGroup="$adminNavGroup" HBox.hgrow="ALWAYS" />
                        <ToggleButton mnemonicParsing="false" onAction="#MovingToSellingPage" prefHeight="40.0" prefWidth="140.0" styleClass="switch-btn" text="Hàng Chờ" toggleGroup="$adminNavGroup" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

            </children>
        </HBox>
    </top>

    <center>
        <AnchorPane fx:id="adminContentArea" style="-fx-background-color: transparent;">
            <children>
                <VBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 24px; -fx-font-weight: bold;" text="HỆ THỐNG QUẢN TRỊ MINIBOOM" />
                        <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 14px;" text="Vui lòng chọn một mục ở thanh menu phía trên để bắt đầu" />
                    </children>
                </VBox>
            </children>
        </AnchorPane>
    </center>

</BorderPane>