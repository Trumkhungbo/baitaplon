<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="ShowingStage" prefHeight="760.0" prefWidth="1200.0" styleClass="root-container" stylesheets="@global.css" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="action.Authentication.AdminLobbyHandle" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <HBox prefHeight="110.0" prefWidth="1200.0" style="-fx-background-color: #151515; -fx-border-color: #2C2C2C; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="295.0" spacing="12.0" style="-fx-padding: 0 0 0 36;" HBox.hgrow="ALWAYS">
                <children>
                    <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../assets/Icon.png" />
                        </image>
                    </ImageView>
                    <VBox alignment="CENTER_LEFT">
                        <children>
                            <Label style="-fx-text-fill: #FACC15; -fx-font-size: 22px; -fx-font-weight: bold;" text="MiniBoom" />
                            <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 12px; -fx-font-weight: bold;" text="AUCTION SYSTEM" />
                        </children>
                    </VBox>
                </children>
            </HBox>
            <Region prefHeight="100.0" prefWidth="164.0" HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="580.0" spacing="14.0" style="-fx-padding: 0 36 0 0;" HBox.hgrow="ALWAYS">
               <children>
                  <Button mnemonicParsing="false" prefHeight="48.0" prefWidth="160.0" styleClass="btn-secondary" text="Tài Khoản" onAction="#MovingToAccountPage" />
                  <Button mnemonicParsing="false" prefHeight="48.0" prefWidth="160.0" styleClass="btn-secondary" text="Yêu Cầu" onAction="#MovingToHandleUserRequest" />
                  <Button mnemonicParsing="false" prefHeight="48.0" prefWidth="160.0" styleClass="btn-secondary" text="Hàng Chờ" onAction="#MovingToSellingPage" />
               </children></HBox>
         </children></HBox>
   </top>
</BorderPane>
