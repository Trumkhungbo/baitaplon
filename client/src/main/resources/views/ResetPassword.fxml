<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #0A0A0A;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.Authentication.ResetPasswordHandle">
    <children>
        <Pane layoutX="90.0" layoutY="40.0" prefHeight="320.0" prefWidth="420.0" style="-fx-background-color: #1A1A1A; -fx-border-color: #FACC15; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-width: 2;">
            <children>

                <Label layoutX="104.0" layoutY="24.0" text="Đặt Lại Mật Khẩu" textFill="#FACC15">
                    <font>
                        <Font name="System Bold" size="26.0" />
                    </font>
                </Label>

                <Label layoutX="50.0" layoutY="85.0" text="Mật khẩu mới:" textFill="#A0A0A0">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <PasswordField fx:id="newPassword" layoutX="50.0" layoutY="110.0" prefHeight="35.0" prefWidth="320.0" promptText="Nhập mật khẩu mới" style="-fx-background-color: #252525; -fx-text-fill: white; -fx-border-color: #444; -fx-background-radius: 5; -fx-border-radius: 5;" />

                <Label layoutX="50.0" layoutY="160.0" text="Xác nhận mật khẩu:" textFill="#A0A0A0">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <PasswordField fx:id="confirmPassword" layoutX="50.0" layoutY="185.0" prefHeight="35.0" prefWidth="320.0" promptText="Nhập lại mật khẩu mới" style="-fx-background-color: #252525; -fx-text-fill: white; -fx-border-color: #444; -fx-background-radius: 5; -fx-border-radius: 5;" />

                <Label fx:id="errorLabel" alignment="CENTER" layoutX="50.0" layoutY="230.0" prefHeight="18.0" prefWidth="320.0" textFill="#ff6b6b">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>

                <Button layoutX="50.0" layoutY="260.0" mnemonicParsing="false" onAction="#ConfirmReset" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #FACC15; -fx-text-fill: black; -fx-background-radius: 8; -fx-cursor: hand;" text="Xác nhận">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>

                <Button layoutX="220.0" layoutY="260.0" mnemonicParsing="false" onAction="#Cancel" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: transparent; -fx-border-color: #FACC15; -fx-text-fill: #FACC15; -fx-border-radius: 8; -fx-cursor: hand;" text="Hủy / Quay lại">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>

            </children>
        </Pane>
    </children>
</AnchorPane>