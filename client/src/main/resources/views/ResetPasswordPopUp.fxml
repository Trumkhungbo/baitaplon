<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<StackPane prefHeight="768.0" prefWidth="1024.0" style="-fx-background-color: rgba(0, 0, 0, 0.85);" stylesheets="@global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.controller.auth.ResetPasswordPopUpHandle">
    <children>
        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="420.0" spacing="25.0" styleClass="card" style="-fx-border-color: #FACC15; -fx-border-width: 1.5; -fx-border-radius: 20;">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>

                <StackPane>
                    <children>
                        <Circle fill="TRANSPARENT" radius="35.0" stroke="#FACC15" strokeType="INSIDE" strokeWidth="2.5" style="-fx-effect: dropshadow(three-pass-box, rgba(250,204,21,0.3), 15, 0, 0, 0);" />
                        <Label text="✓" textFill="#FACC15">
                            <font>
                                <Font name="System Bold" size="40.0" />
                            </font>
                        </Label>
                    </children>
                </StackPane>

                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="Thay đổi thành công!" />
                        <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 14px;" text="Mật khẩu của bạn đã được cập nhật. Vui lòng sử dụng mật khẩu mới để đăng nhập." textAlignment="CENTER" wrapText="true" />
                    </children>
                </VBox>

                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#ReturnToLogin" prefHeight="45.0" styleClass="btn-gold" text="QUAY LẠI ĐĂNG NHẬP">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </children>
</StackPane>