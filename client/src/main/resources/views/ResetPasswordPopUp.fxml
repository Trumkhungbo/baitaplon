<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: rgba(0, 0, 0, 0.7);" stylesheets="@global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.Authentication.ResetPasswordPopUpHandle">
    <children>
        <VBox alignment="CENTER" maxHeight="300.0" maxWidth="450.0" spacing="20.0" style="-fx-background-color: #1A1A1A; -fx-background-radius: 15; -fx-border-color: #FACC15; -fx-border-radius: 15; -fx-border-width: 2;">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>
                <StackPane>
                    <children>
                        <Circle fill="TRANSPARENT" radius="30.0" stroke="#FACC15" strokeType="INSIDE" strokeWidth="2.0" />
                        <Label text="✓" textFill="#FACC15">
                            <font>
                                <Font name="System Bold" size="36.0" />
                            </font>
                        </Label>
                    </children>
                </StackPane>

                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label style="-fx-text-fill: #FACC15; -fx-font-size: 20px; -fx-font-weight: bold;" text="Thay đổi thành công!" />
                        <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 14px; -fx-text-alignment: center;" text="Mật khẩu của bạn đã được thay đổi.&#10;Bấm để quay lại trang đăng nhập." wrapText="true" />
                    </children>
                </VBox>

                <Button maxWidth="200.0" mnemonicParsing="false" onAction="#ReturnToLogin" style="-fx-background-color: #FACC15; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="Return To Login">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </children>
</StackPane>