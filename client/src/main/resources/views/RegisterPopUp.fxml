<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="400.0" prefWidth="600.0" styleClass="root-container" stylesheets="@global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.controller.auth.RegisterPopUpHandle">
   <children>
      <VBox alignment="CENTER" maxHeight="300.0" maxWidth="450.0" spacing="20.0" styleClass="card">
         <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
         </padding>
         <children>

            <StackPane>
               <children>
                  <Circle fill="TRANSPARENT" radius="30.0" stroke="#FACC15" strokeType="INSIDE" strokeWidth="2.0" />
                  <Label text="✓" textFill="#FACC15">
                     <font>
                        <Font name="System Bold" size="36.0" />
                     </font>
                  </Label>
               </children>
            </StackPane>

            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label style="-fx-text-fill: #FACC15; -fx-font-size: 20px; -fx-font-weight: bold;" text="Đăng ký thành công!" />
                  <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 14px; -fx-text-alignment: center;" text="Tài khoản của bạn đã được khởi tạo.&#10;Bấm để quay lại trang đăng nhập." wrapText="true" />
               </children>
            </VBox>

            <Button maxWidth="200.0" mnemonicParsing="false" onAction="#ReturnToLogin" styleClass="btn-gold" text="Return To Login">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>

         </children>
      </VBox>
   </children>
</StackPane>