<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="ShowingStage" prefHeight="768.0" prefWidth="1366.0" styleClass="root-container" stylesheets="@global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.MainUI.LobbyHandle">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="top-navbar" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="30.0" right="30.0" top="12.0" />
         </padding>
         <children>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../assets/Icon.png" />
                     </image>
                  </ImageView>
                  <VBox alignment="CENTER_LEFT">
                     <children>
                        <Label style="-fx-text-fill: #FACC15; -fx-font-size: 22px; -fx-font-weight: bold;" text="MiniBoom" />
                        <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 12px; -fx-font-weight: bold;" text="AUCTION SYSTEM" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <fx:define>
               <ToggleGroup fx:id="navbarGroup" />
            </fx:define>

            <HBox alignment="CENTER" styleClass="switch-container">
               <children>
                  <ToggleButton maxWidth="Infinity" mnemonicParsing="false" onAction="#ReturnLobby" selected="true" styleClass="switch-btn" text="Trang Chủ" toggleGroup="$navbarGroup" HBox.hgrow="ALWAYS" />
                  <ToggleButton maxWidth="Infinity" mnemonicParsing="false" onAction="#ReturnDesiner" styleClass="switch-btn" text="Giới Thiệu" toggleGroup="$navbarGroup" HBox.hgrow="ALWAYS" />
                  <ToggleButton maxWidth="-Infinity" mnemonicParsing="false" onAction="#ReturnSeller" selected="true" styleClass="switch-btn" text="Phòng Đăng Bán" toggleGroup="$navbarGroup" HBox.hgrow="ALWAYS" />
                  <ToggleButton maxWidth="Infinity" mnemonicParsing="false" onAction="#ReturnInvesmentWait" styleClass="switch-btn" text="Phòng Chuẩn Bị" toggleGroup="$navbarGroup" HBox.hgrow="ALWAYS" />
                  <ToggleButton maxWidth="Infinity" mnemonicParsing="false" onAction="#ReturnInvesmentSite" styleClass="switch-btn" text="Phòng Đấu Giá" toggleGroup="$navbarGroup" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button mnemonicParsing="false" onAction="#AccountInformation" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
               <graphic>
                  <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 3);">
                     <image>
                        <Image url="@../assets/profilepic.jpg" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>

         </children>
      </HBox>
   </top>

   <center>
      <StackPane BorderPane.alignment="CENTER">
      </StackPane>
   </center>
</BorderPane>