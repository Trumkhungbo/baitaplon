<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane prefHeight="720.0" prefWidth="1080.0" styleClass="root-container" stylesheets="@global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.Authentication.ActionInformationHandle">
    <children>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox alignment="TOP_CENTER" spacing="40.0">
                    <padding>
                        <Insets bottom="50.0" left="20.0" right="20.0" top="40.0" />
                    </padding>
                    <children>

                        <HBox alignment="CENTER" maxWidth="900.0" spacing="20.0">
                            <children>
                                <Circle fill="#FACC15" radius="45.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" />
                                <VBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="name" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" text="Admin" />
                                        <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 14px;" text="Thành viên chính thức" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" onAction="#ReturnToLogin" style="-fx-background-color: transparent; -fx-border-color: #FF4444; -fx-border-radius: 8px; -fx-text-fill: #FF4444; -fx-cursor: hand;" text="Đăng xuất">
                                    <padding>
                                        <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
                                    </padding>
                                </Button>
                            </children>
                        </HBox>

                        <HBox alignment="TOP_CENTER" maxWidth="1000.0" spacing="30.0">
                            <children>

                                <VBox spacing="20.0" styleClass="card-profile" HBox.hgrow="ALWAYS">
                                    <padding>
                                        <Insets bottom="35.0" left="35.0" right="35.0" top="35.0" />
                                    </padding>
                                    <children>
                                        <Label style="-fx-text-fill: #FACC15; -fx-font-size: 20px; -fx-font-weight: bold;" text="Thông tin cá nhân" />
                                        <GridPane vgap="20.0">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                                            </columnConstraints>
                                            <children>
                                                <Label style="-fx-text-fill: #666666;" text="Số CCCD:" />
                                                <Label fx:id="personalID" style="-fx-text-fill: white;" text="123123123123" GridPane.columnIndex="1" />

                                                <Label style="-fx-text-fill: #666666;" text="Số điện thoại:" GridPane.rowIndex="1" />
                                                <Label fx:id="phone" style="-fx-text-fill: white;" text="0987654321" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                                <Label style="-fx-text-fill: #666666;" text="Email:" GridPane.rowIndex="2" />
                                                <Label fx:id="email" style="-fx-text-fill: white;" text="admin@gmail.com" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                                <Label style="-fx-text-fill: #666666;" text="Mật khẩu:" GridPane.rowIndex="3" />
                                                <Label fx:id="password" style="-fx-text-fill: white;" text="123" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                            </children>
                                 <rowConstraints>
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                    <RowConstraints />
                                 </rowConstraints>
                                        </GridPane>
                                    </children>
                                </VBox>

                                <VBox prefWidth="380.0" spacing="25.0">
                                    <children>
                                        <VBox spacing="10.0" style="-fx-background-color: linear-gradient(to bottom right, #1A1A1A, #252525);" styleClass="card-profile">
                                            <padding>
                                                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                                            </padding>
                                            <children>
                                                <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 14px;" text="Số dư hiện tại" />
                                                <Label fx:id="money" style="-fx-text-fill: #FACC15; -fx-font-size: 36px; -fx-font-weight: bold;" text="0" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="20.0" styleClass="card-profile">
                                            <padding>
                                                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                                            </padding>
                                            <children>
                                                <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" text="Nạp thêm tiền" />
                                                <TextField fx:id="moneyIn" promptText="Nhập số tiền (VNĐ)" styleClass="input-field" />
                                                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#addMoney" styleClass="btn-gold" text="Xác nhận nạp" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                  <HBox prefWidth="1025.0" VBox.vgrow="ALWAYS">
                     <children>
                        <ScrollPane hbarPolicy="NEVER" prefHeight="140.0" prefWidth="1011.0" HBox.hgrow="ALWAYS">
                           <content>
                               <TableView fx:id="ItemsTable" prefHeight="276.0" prefWidth="1010.0" styleClass="custom-table" VBox.vgrow="ALWAYS">
                                   <columnResizePolicy>
                                       <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                   </columnResizePolicy>
                                   <columns>
                                       <TableColumn fx:id="STTColumn" maxWidth="50.0" minWidth="50.0" text="STT" />
                                       <TableColumn fx:id="ProductName" text="Tên Sản Phẩm" />
                                       <TableColumn fx:id="ProductDescription" text="Mô Tả" />
                                       <TableColumn fx:id="Productinfomation1" text="Thông tin 1" />
                                       <TableColumn fx:id="Productinfomation2" text="Thông tin 2" />
                                       <TableColumn fx:id="ProductPrice" text="Giá Mua Vào" />
                                       <TableColumn fx:id="ProductDate" text="Ngày Đấu" />
                                       <TableColumn fx:id="ProductTime" text="Giờ Bắt Đầu" />
                                       <TableColumn fx:id="CheckBox" maxWidth="82.39999999999998" minWidth="76.79996337890623" prefWidth="76.79996337890623" text="Trạng Thái" />
                                   </columns>
                               </TableView>
                           </content>
                        </ScrollPane>
                     </children>
                  </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</StackPane>
