<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-background-color: transparent;" stylesheets="@global.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.MainUI.AdminHandleUserRequestHandle">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>

        <VBox spacing="5.0">
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="Quản Lý Yêu Cầu Nạp Tiền" />
                <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 13px;" text="Kiểm tra và phê duyệt các giao dịch từ người dùng." />
            </children>
        </VBox>

        <TableView fx:id="table" styleClass="custom-table" VBox.vgrow="ALWAYS">

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>

            <columns>
                <TableColumn fx:id="STTColumn" maxWidth="50.0" minWidth="50.0" text="STT" />

                <TableColumn fx:id="UserName" text="Tên Người Dùng" />
                <TableColumn fx:id="UserBalance" text="Số Dư Hiện Tại" />
                <TableColumn fx:id="UserAddingMoney" text="Số Tiền Nạp" />

                <TableColumn fx:id="Button" maxWidth="100.0" minWidth="100.0" text="Duyệt" />
            </columns>
        </TableView>

    </children>
</VBox>
