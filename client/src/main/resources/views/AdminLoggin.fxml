<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="700.0" prefWidth="900.0" styleClass="root-container" stylesheets="@global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.controller.auth.AdminLogginHandle">
   <children>
      <VBox alignment="CENTER" spacing="30.0" styleClass="card">
         <padding>
            <Insets bottom="50.0" left="40.0" right="40.0" top="50.0" />
         </padding>
         <children>

            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <Circle fill="TRANSPARENT" radius="35.0" stroke="#FACC15" strokeType="INSIDE" strokeWidth="2.0" />
                  <Label text="ADMIN" textFill="#FACC15">
                     <font>
                        <Font name="System Bold" size="36.0" />
                     </font>
                  </Label>
                  <Label style="-fx-text-fill: #FACC15; -fx-font-size: 22px; -fx-font-weight: bold;" text="Admin Access" />
               </children>
            </VBox>

            <Label fx:id="label" style="-fx-text-fill: #FF4444; -fx-font-size: 15px;" text="Vui lòng xác thực quyền quản trị" textAlignment="CENTER" wrapText="true" />

            <VBox spacing="10.0">
               <children>
                  <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 13px;" text="Tên đăng nhập" />
                  <TextField fx:id="usernameField" maxWidth="Infinity" prefHeight="45.0" promptText="Nhập tài khoản admin" styleClass="input-field" />
                  <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 13px;" text="Mật khẩu" />
                  <PasswordField fx:id="passwordField" maxWidth="Infinity" prefHeight="45.0" promptText="Nhập mật khẩu" styleClass="input-field" />
               </children>
            </VBox>

            <VBox spacing="15.0" alignment="CENTER">
               <children>
                  <Button fx:id="button" maxWidth="Infinity" mnemonicParsing="false" onAction="#Submitting" styleClass="btn-gold" text="Đăng nhập Admin" />
                  <Button mnemonicParsing="false" onAction="#ReturnLogin" style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-font-size: 13px; -fx-cursor: hand;" text="Quay lại Đăng nhập" />
               </children>
            </VBox>

         </children>
      </VBox>
   </children>
</StackPane>
