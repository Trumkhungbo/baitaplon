<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.SellingJobs.InvesmentSiteHandle" style="-fx-background-color: transparent;">
   <children>
      <VBox spacing="18.0" style="-fx-padding: 22 18 30 18;">
         <children>
            <HBox spacing="10.0">
               <children>
                  <Button fx:id="filterAllButton" mnemonicParsing="false" onAction="#showAll" prefHeight="34.0" text="Tất cả" />
                  <Button fx:id="filterElectronicsButton" mnemonicParsing="false" onAction="#showElectronics" prefHeight="34.0" text="Electronics" />
                  <Button fx:id="filterArtButton" mnemonicParsing="false" onAction="#showArt" prefHeight="34.0" text="Art" />
                  <Button fx:id="filterVehiclesButton" mnemonicParsing="false" onAction="#showVehicles" prefHeight="34.0" text="Vehicles" />
               </children>
            </HBox>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
               <content>
                  <FlowPane fx:id="flowPane" hgap="24.0" vgap="24.0" style="-fx-padding: 10 6 20 6;" />
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</StackPane>
