<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="1000.0" spacing="20.0" styleClass="root-container" stylesheets="@global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.MainUI.AdminSellingPageHandle">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <Label style="-fx-text-fill: #FACC15; -fx-font-size: 24px; -fx-font-weight: bold;" text="Quản lý &amp; Duyệt sản phẩm" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#LogOut" styleClass="btn-gold" text="Đăng xuất" />
            </children>
        </HBox>

        <VBox styleClass="card" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <TableView fx:id="ItemsTable" styleClass="custom-table" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="STTColumn" maxWidth="50.0" minWidth="50.0" text="STT" />
                        <TableColumn fx:id="ProductName" text="Tên sản phẩm" />
                        <TableColumn fx:id="ProductDescription" text="Mô tả" />
                        <TableColumn fx:id="Productinfomation1" text="Thông tin 1" />
                        <TableColumn fx:id="Productinfomation2" text="Thông tin 2" />
                        <TableColumn fx:id="ProductPrice" text="Giá khởi điểm" />
                        <TableColumn fx:id="ProductDate" text="Ngày đấu" />
                        <TableColumn fx:id="ProductTime" text="Giờ bắt đầu" />
                        <TableColumn fx:id="SellingTime" text="TG đấu (phút)" />
                        <TableColumn fx:id="CheckBox" maxWidth="80.0" minWidth="80.0" text="Duyệt" />
                    </columns>
                </TableView>
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#Confirm" styleClass="btn-gold" text="Xác nhận duyệt" />
            </children>
        </HBox>
    </children>
</VBox>
