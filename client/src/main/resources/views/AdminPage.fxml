<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="700.0" prefWidth="1000.0" spacing="20.0" styleClass="root-container" stylesheets="@global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.MainUI.AdminpageHandle">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <Label style="-fx-text-fill: #FACC15; -fx-font-size: 24px; -fx-font-weight: bold;" text="Quản lý &amp; Duyệt sản phẩm" />
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 14px;" text="Admin Dashboard" />
            </children>
        </HBox>

        <VBox styleClass="card" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <TableView fx:id="ItemsTable" styleClass="custom-table" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="STTColumn" maxWidth="50.0" minWidth="50.0" text="STT" />
                        <TableColumn fx:id="ProductName" text="Tên Sản Phẩm" />
                        <TableColumn fx:id="ProductDescription" text="Mô Tả" />
                        <TableColumn fx:id="Productinfomation1" text="Thông tin1"/>
                        <TableColumn fx:id = "Productinfomation2" text = "Thong tin2"/>
                        <TableColumn fx:id="ProductPrice" text="Giá Khởi Điểm" />
                        <TableColumn fx:id="ProductDate" text="Ngày Đấu" />
                        <TableColumn fx:id="ProductTime" text="Giờ Bắt Đầu" />
                        <TableColumn fx:id="SellingTime" text="TG Đấu (Phút)" />
                        <TableColumn fx:id="CheckBox" maxWidth="80.0" minWidth="80.0" text="Duyệt" />
                    </columns>
                </TableView>
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-cursor: hand;" text="Tải lại danh sách" />
                <Button mnemonicParsing="false" onAction="#Confirm" styleClass="btn-gold" text="Xác nhận duyệt" />
            </children>
        </HBox>
    </children>
</VBox>