<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="600.0" prefWidth="800.0" styleClass="root-container" stylesheets="@global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.Authentication.ForgotPasswordHandle">
   <children>
      <VBox alignment="CENTER" maxHeight="450.0" maxWidth="400.0" spacing="20.0" styleClass="card">
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
         <children>

            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <Circle fill="TRANSPARENT" radius="30.0" stroke="#FACC15" strokeType="INSIDE" strokeWidth="2.0" />
                  <Label text="?" textFill="#FACC15">
                     <font>
                        <Font name="System Bold" size="32.0" />
                     </font>
                  </Label>
                  <Label style="-fx-text-fill: #FACC15; -fx-font-size: 20px; -fx-font-weight: bold;" text="Quên mật khẩu" />
                  <Label style="-fx-text-fill: #A0A0A0; -fx-font-size: 13px; -fx-text-alignment: center;" text="Nhập thông tin xác thực để lấy lại mật khẩu" wrapText="true" />
               </children>
            </VBox>

            <VBox spacing="15.0">
               <children>
                  <TextField fx:id="username" promptText="Tên đăng nhập" styleClass="input-field" />
                  <TextField fx:id="Id" promptText="Số CCCD" styleClass="input-field" />
                  <TextField fx:id="phoneNumber" promptText="Số điện thoại" styleClass="input-field" />
               </children>
            </VBox>

            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#TakePass" styleClass="btn-gold" text="Lấy lại mật khẩu">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Button>

                  <Button mnemonicParsing="false" onAction="#BackToLogin" style="-fx-background-color: transparent; -fx-text-fill: #A0A0A0; -fx-font-size: 12px; -fx-cursor: hand;" text="Quay lại Đăng nhập" />
               </children>
            </VBox>

         </children>
      </VBox>
   </children>
</StackPane>
