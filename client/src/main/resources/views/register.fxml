<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane prefHeight="750.0" prefWidth="900.0" styleClass="root-container" stylesheets="@global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="action.Authentication.RegisterHandle">
   <children>
      <VBox alignment="CENTER" maxHeight="650.0" maxWidth="450.0" spacing="15.0" styleClass="card">
         <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
         </padding>
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Circle fill="#FACC15" radius="20.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" />
                  <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Auction" />
               </children>
            </VBox>

            <Label style="-fx-text-fill: #FACC15; -fx-font-size: 22px; -fx-font-weight: bold;" text="Đăng ký tài khoản">
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
            </Label>

            <VBox spacing="12.0">
               <children>
                  <TextField fx:id="Name" promptText="Họ và tên" styleClass="input-field" />
                  <TextField fx:id="PhoneNumber" promptText="Số điện thoại" styleClass="input-field" />
                  <TextField fx:id="Email" promptText="Email" styleClass="input-field" />
                  <TextField fx:id="PersonalID" promptText="Số CCCD" styleClass="input-field" />
                  <PasswordField fx:id="Password" promptText="Mật khẩu" styleClass="input-field" />
                  <PasswordField fx:id="ConfirmPassword" promptText="Xác nhận mật khẩu" styleClass="input-field" />
               </children>
            </VBox>

            <CheckBox mnemonicParsing="false" style="-fx-text-fill: #A0A0A0; -fx-font-size: 11px;" text="Tôi đồng ý với Điều khoản và Chính sách bảo mật" wrapText="true" />

            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#Register" styleClass="btn-gold" text="Đăng ký">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>

            <HBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label style="-fx-text-fill: #666666; -fx-font-size: 13px;" text="Đã có tài khoản?" />
                  <Button mnemonicParsing="false" onAction="#Login" style="-fx-background-color: transparent; -fx-text-fill: #FACC15; -fx-font-weight: bold; -fx-cursor: hand;" text="Đăng nhập" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</StackPane>